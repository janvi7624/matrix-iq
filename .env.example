# Copy to .env.local and fill in real values. .env.local is gitignored.

# One-time bootstrap admin account. Only used to seed the very first user in
# the users table when it's empty (e.g. a fresh install). After that, manage
# all accounts (including this one) via /admin/users in the app.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Random secret used to sign the login session cookie for every user. Generate
# one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Supabase Postgres connection string used by Sequelize (lib/db.ts). Use the
# pooled/"Transaction" mode URI from Supabase → Project Settings → Database →
# Connection string, since Next.js API routes run as short-lived serverless
# functions. Format:
#   postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=

# Only needed if your Supabase tables live outside the default "public" schema.
DATABASE_SCHEMA=public

# Public base URL of this app (no trailing slash), e.g. https://app.example.com.
# Used to build absolute links (login URL, logo) in outgoing emails.
APP_URL=

# AWS SES — used by lib/email/emailService.ts to send account-creation
# emails (and future notification emails). AWS_SES_FROM_EMAIL must be a
# verified SES sender identity. If these are left blank, emails are skipped
# (logged, not sent) instead of failing the action that triggered them.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=

# File storage — every uploaded file: reimbursement bills, scanned business
# cards, site-visit photos, PO/demo/installation attachments. See
# lib/fileStorage.ts, which supports two backends:
#
#   FILE_STORAGE unset (default)  bytes are stored in this app's own Postgres,
#                                 in the file_objects table. Nothing else to
#                                 set up, and they are covered by the database
#                                 backup.
#   FILE_STORAGE=s3               bytes are stored in the S3 bucket below.
#                                 Keeps the database small; needs the bucket to
#                                 exist and the IAM key to allow s3:PutObject,
#                                 s3:GetObject and s3:DeleteObject on it.
#
# Both write the SAME key, so a file's stored URL never changes when the
# backend does. The bucket MUST be private — files are served only through the
# app's own authenticated routes, never a public or presigned URL.
# AWS_S3_REGION / the S3 credentials fall back to AWS_REGION and the
# AWS_ACCESS_KEY_ID pair above; set them only to keep file storage on a
# different key from the SES sending key.
FILE_STORAGE=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# Supabase Storage — RETIRED. The project that held these files was deleted;
# its bucket and everything in it went with it. Kept only because
# scripts/restore-supabase-attachments.js can copy files out of a restored
# Supabase project into whichever backend is configured above. Leave blank
# unless performing that recovery.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta (Facebook/Instagram) Lead Ads — lib/metaConfig.ts,
# app/api/integrations/meta/webhook, Administration → Meta Lead Integration.
# META_APP_SECRET and META_PAGE_ACCESS_TOKEN are server-only secrets: never
# exposed to the client, never stored in the database. If these are left
# unset, the integration is inert (the webhook rejects every event, the
# admin page shows "Not configured") rather than crashing the app.
#   META_APP_ID / META_APP_SECRET  — Meta Developer Console → your App → Settings → Basic
#   META_VERIFY_TOKEN              — any string you choose; enter the same value
#                                     in the Console's webhook setup and here
#   META_PAGE_ID                   — the Facebook Page's numeric ID
#   META_PAGE_ACCESS_TOKEN         — a Page access token with leads_retrieval,
#                                     pages_manage_metadata, pages_show_list,
#                                     pages_read_engagement, ads_management
#                                     (obtained via Meta Business Suite / Graph
#                                     API Explorer — see the integration's
#                                     setup report for the full walkthrough)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Daily Report scheduler (app/api/cron/daily-report-sweep).
#
# This app runs no in-process timer, so the reminder/warning/escalation sweep
# is an idempotent HTTP endpoint that an external scheduler calls on a fixed
# cadence. That endpoint is in proxy.ts's PUBLIC_PATHS — a cron process has no
# session cookie — so this shared secret is the ONLY thing authenticating it.
#
# Leave it unset and the route answers 503 to everything: an unauthenticated
# endpoint that can email the whole company fails closed, so a deployment that
# forgets this gets no reminders rather than an open trigger. Nothing warns you
# except the banner on Administration -> Daily Report Configuration, which
# reads "DAILY_REPORT_CRON_SECRET is not set on this deployment".
#
# Generate one that is long and random — it is a bearer token, not a password:
#   openssl rand -hex 32
#
# Then use the same value as the Bearer token from the scheduler, hourly:
#   0 * * * * curl -fsS -X POST -H "Authorization: Bearer $DAILY_REPORT_CRON_SECRET" \
#     https://your-host/api/cron/daily-report-sweep
#
# Hourly is enough: the sweep works out what is due rather than needing to
# fire at the deadline exactly, every side effect is guarded by a unique
# database row, and a missed hour is reconciled by the next call.
#
# Setting this does NOT start anything on its own — scheduler_enabled and
# dry_run in Daily Report Configuration still gate every send.
DAILY_REPORT_CRON_SECRET=
